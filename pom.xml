<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- 1) Inherit Spring Boot’s BOM and plugin management -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.1.0</version>
    <relativePath/> <!-- lookup from repo -->
  </parent>

  <groupId>com.dlim2012</groupId>
  <artifactId>hotelbooking</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>hotelbooking</name>
  <description>Hotel Booking System</description>

  <!-- 2) Define any extra BOM versions you need -->
  <properties>
    <java.version>17</java.version>
    <!-- Spring Cloud BOM version -->
    <spring-cloud.version>2022.0.3</spring-cloud.version>
  </properties>

  <!-- 3) Import Spring Cloud BOM under dependencyManagement -->
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.cloud</groupId>
        <artifactId>spring-cloud-dependencies</artifactId>
        <version>${spring-cloud.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <modules>
    <module>apigw</module>
    <module>hotel</module>
    <module>eureka-server</module>
    <module>search-consumer</module>
    <module>search</module>
    <module>user</module>
    <module>booking</module>
    <module>booking-management</module>
    <module>archival</module>
    <module>clients</module>
    <module>client_cassandra</module>
    <module>client_security</module>
    <module>notification</module>
  </modules>

  <dependencies>
    <!-- Lombok (provided by IDE/runtime) -->
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <scope>provided</scope>
    </dependency>

    <!-- JPA, MySQL driver, Jackson JSR-310 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.datatype</groupId>
      <artifactId>jackson-datatype-jsr310</artifactId>
    </dependency>

    <!-- Elasticsearch REST client -->
    <dependency>
      <groupId>org.elasticsearch.client</groupId>
      <artifactId>elasticsearch-rest-high-level-client</artifactId>
      <version>7.11.2</version>
    </dependency>
  </dependencies>

  <!-- pluginManagement is inherited from spring-boot-starter-parent -->
  <build>
    <pluginManagement>
      <plugins>
        <!-- You don’t need to declare Spring Boot Maven Plugin version
             unless you want to override it. The parent sets this to 3.1.0. -->
      </plugins>
    </pluginManagement>
  </build>
</project>
